  "sentences": [
    {
      "id": "s_28_01",
      "hr": "Klimatske promjene su veliki problem.",
      "de": "Der Klimawandel ist ein großes Problem."
    },
    {
      "id": "s_28_02",
      "hr": "To je ozbiljan problem.",
      "de": "Das ist ein ernstes Problem."
    },
    {
      "id": "s_28_03",
      "hr": "Globalno zatopljenje je ozbiljan problem.",
      "de": "Die globale Erwärmung ist ein ernstes Problem."
    },
    {
      "id": "s_28_04",
      "hr": "U gradu je bila poplava.",
      "de": "In der Stadt gab es Hochwasser.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_28_05",
      "hr": "Ljeti ima puno požara.",
      "de": "Im Sommer gibt es viele Brände.",
      "grammar": "g_b1_mnozina_kolicina"
    },
    {
      "id": "s_28_06",
      "hr": "Šume su gorjele tri dana.",
      "de": "Die Wälder brannten drei Tage lang."
    },
    {
      "id": "s_28_07",
      "hr": "Kuća je izgorjela.",
      "de": "Das Haus ist abgebrannt.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_28_08",
      "hr": "Razina mora raste.",
      "de": "Der Meeresspiegel steigt."
    },
    {
      "id": "s_28_09",
      "hr": "Rijeka je zagađena.",
      "de": "Der Fluss ist verschmutzt."
    },
    {
      "id": "s_28_10",
      "hr": "Obnovljiva energija je budućnost.",
      "de": "Erneuerbare Energie ist die Zukunft."
    },
    {
      "id": "s_28_11",
      "hr": "Koji je uzrok požara?",
      "de": "Was ist die Ursache des Brandes?"
    },
    {
      "id": "s_28_12",
      "hr": "Posljedice su ozbiljne.",
      "de": "Die Folgen sind ernst."
    },
    {
      "id": "s_28_13",
      "hr": "Promet ima velik utjecaj na zrak.",
      "de": "Der Verkehr hat großen Einfluss auf die Luft."
    },
    {
      "id": "s_28_14",
      "hr": "Promet utječe na zdravlje.",
      "de": "Der Verkehr beeinflusst die Gesundheit."
    },
    {
      "id": "s_28_15",
      "hr": "Požari su vrlo opasni.",
      "de": "Brände sind sehr gefährlich."
    },
    {
      "id": "s_28_16",
      "hr": "Ovdje živi puno vrsta ptica.",
      "de": "Hier leben viele Vogelarten.",
      "grammar": "g_b1_mnozina_kolicina"
    },
    {
      "id": "s_28_17",
      "hr": "Neke vrste će nestati.",
      "de": "Manche Arten werden verschwinden.",
      "grammar": "g_futur"
    },
    {
      "id": "s_28_18",
      "hr": "Ova vrsta je ugrožena.",
      "de": "Diese Art ist bedroht."
    },
    {
      "id": "s_28_19",
      "hr": "Plitvice su nacionalni park.",
      "de": "Plitvice ist ein Nationalpark."
    },
    {
      "id": "s_28_20",
      "hr": "Idemo u špilju.",
      "de": "Wir gehen in die Höhle.",
      "grammar": "g_wohin"
    },
    {
      "id": "s_28_21",
      "hr": "Hodajući šumom, vidjeli smo jelena.",
      "de": "Während wir durch den Wald gingen, sahen wir einen Hirsch.",
      "grammar": "g_b2_prilog",
      "note": "hodati → hodajući (während)"
    },
    {
      "id": "s_28_22",
      "hr": "Ljepota krajolika je nevjerojatna.",
      "de": "Die Schönheit der Landschaft ist unglaublich."
    },
    {
      "id": "s_28_23",
      "hr": "Borimo se za prirodu.",
      "de": "Wir kämpfen für die Natur."
    },
    {
      "id": "s_28_24",
      "hr": "Kako rješavate taj problem?",
      "de": "Wie lösen Sie dieses Problem?"
    },
    {
      "id": "s_28_25",
      "hr": "Problem je riješen.",
      "de": "Das Problem ist gelöst.",
      "grammar": "g_b2_pasiv"
    },
    {
      "id": "s_28_26",
      "hr": "Ljudi nemaju dovoljno svijesti o okolišu.",
      "de": "Die Menschen haben zu wenig Umweltbewusstsein.",
      "grammar": "g_genitiv"
    }
