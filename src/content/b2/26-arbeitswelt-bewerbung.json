  "sentences": [
    {
      "id": "s_26_01",
      "hr": "Vidio sam natječaj za posao.",
      "de": "Ich habe die Stellenausschreibung gesehen."
    },
    {
      "id": "s_26_02",
      "hr": "Pošaljite nam svoj životopis.",
      "de": "Schicken Sie uns Ihren Lebenslauf.",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_03",
      "hr": "Morate poslati i motivacijsko pismo.",
      "de": "Sie müssen auch ein Motivationsschreiben schicken.",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_04",
      "hr": "Sutra imam razgovor za posao.",
      "de": "Morgen habe ich ein Vorstellungsgespräch."
    },
    {
      "id": "s_26_05",
      "hr": "Tvrtka ima sto zaposlenika.",
      "de": "Die Firma hat hundert Mitarbeiter.",
      "grammar": "g_b1_mnozina"
    },
    {
      "id": "s_26_06",
      "hr": "Zaposlili su me prošle godine.",
      "de": "Sie haben mich letztes Jahr eingestellt.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_26_07",
      "hr": "Tražim novo radno mjesto.",
      "de": "Ich suche eine neue Stelle."
    },
    {
      "id": "s_26_08",
      "hr": "Imate li diplomu?",
      "de": "Haben Sie einen Abschluss?",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_09",
      "hr": "Koje vještine imate?",
      "de": "Welche Fähigkeiten haben Sie?",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_10",
      "hr": "Znanje jezika je prednost.",
      "de": "Sprachkenntnisse sind von Vorteil."
    },
    {
      "id": "s_26_11",
      "hr": "To je velika odgovornost.",
      "de": "Das ist eine große Verantwortung."
    },
    {
      "id": "s_26_12",
      "hr": "Ona je vrlo odgovorna.",
      "de": "Sie ist sehr verantwortungsbewusst."
    },
    {
      "id": "s_26_13",
      "hr": "Radim u malom timu.",
      "de": "Ich arbeite in einem kleinen Team.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_26_14",
      "hr": "Dobro surađujemo.",
      "de": "Wir arbeiten gut zusammen."
    },
    {
      "id": "s_26_15",
      "hr": "Primili smo Vašu ponudu.",
      "de": "Wir haben Ihr Angebot erhalten.",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_16",
      "hr": "Želim napredovati.",
      "de": "Ich möchte mich weiterentwickeln."
    },
    {
      "id": "s_26_17",
      "hr": "Tražio sam povišicu.",
      "de": "Ich habe um eine Gehaltserhöhung gebeten.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_26_18",
      "hr": "Dao je otkaz.",
      "de": "Er hat gekündigt.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_26_19",
      "hr": "Poštovani gospodine!",
      "de": "Sehr geehrter Herr!",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_20",
      "hr": "S poštovanjem, Ana",
      "de": "Mit freundlichen Grüßen, Ana",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_21",
      "hr": "Životopis je u privitku.",
      "de": "Der Lebenslauf ist im Anhang.",
      "grammar": "g_b2_formalno"
    },
    {
      "id": "s_26_22",
      "hr": "Kad budete ispunili sve uvjete, javite se.",
      "de": "Wenn Sie alle Bedingungen erfüllt haben, melden Sie sich.",
      "grammar": "g_b2_futur2"
    },
    {
      "id": "s_26_23",
      "hr": "Kad budete ispunili obrazac, predajte ga.",
      "de": "Wenn Sie das Formular ausgefüllt haben, geben Sie es ab.",
      "grammar": "g_b2_futur2"
    },
    {
      "id": "s_26_24",
      "hr": "Ako budeš samostalan, brzo ćeš napredovati.",
      "de": "Wenn du selbstständig bist, kommst du schnell voran.",
      "grammar": "g_b2_futur2"
