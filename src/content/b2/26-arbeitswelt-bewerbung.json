  "grammar": [
    {
      "id": "g_b2_futur2",
      "title": "Futur II: kad budem …",
      "summary": "Kad budem stigao, nazvat ću te.",
      "body": [
        "Das Futur II steht fast nur in Nebensätzen nach kad (wenn/sobald), ako (falls) und čim (sobald), wenn es um die Zukunft geht. Im Hauptsatz steht dann das Futur I.",
        "Bildung: Präsens von biti in der Form budem, budeš … + l-Partizip.",
        "Bei biti selbst reicht die Kurzform: Ako budeš samostalan … (statt *budeš bio).",
        "Im Alltag hört man statt Futur II oft das Präsens eines vollendeten Verbs: Kad stignem, nazvat ću te."
      ],
      "table": {
        "head": [
          "Person",
          "Form",
          "Beispiel"
        ],
        "rows": [
          [
            "ja",
            "budem",
            "Kad budem imao vremena, …"
          ],
          [
            "ti",
            "budeš",
            "Ako budeš trebao pomoć, …"
          ],
          [
            "on / ona",
            "bude",
            "Čim bude gotovo, …"
          ],
          [
            "mi",
            "budemo",
            "Kad budemo stigli, …"
          ],
          [
            "vi",
            "budete",
            "Kad budete ispunili obrazac, …"
          ],
          [
            "oni",
            "budu",
            "Ako budu imali pitanja, …"
          ]
        ]
      }
    },
    {
      "id": "g_b2_formalno",
      "title": "Formelles Register",
      "summary": "Poštovani gospodine … – S poštovanjem",
      "body": [
        "In formellen Situationen (Bewerbung, Behörde, Kunden) siezt man mit Vi – in Briefen und E-Mails großgeschrieben: Vi, Vas, Vam, Vaš.",
        "Anrede: Poštovani gospodine Horvat, / Poštovana gospođo Horvat, (mit Vokativ!). Ohne Namen: Poštovani,",
        "Schluss: S poštovanjem (Mit freundlichen Grüßen) – etwas lockerer: Lijep pozdrav.",
        "Typische Floskeln: U privitku Vam šaljem životopis. · Unaprijed zahvaljujem. (Vielen Dank im Voraus.)"
      ]
    }
