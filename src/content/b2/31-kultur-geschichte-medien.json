            "Bio sam umoran, ali sam ipak došao."
          ],
          [
            "stoga",
            "deshalb, daher",
            "Pada kiša, stoga ostajemo kod kuće."
          ],
          [
            "naime",
            "nämlich",
            "Naime, bolestan sam."
          ],
          [
            "osim toga",
            "außerdem",
            "Osim toga, grad nije skup."
          ],
          [
            "unatoč",
            "trotz (+ Dativ)",
            "unatoč kiši"
          ],
          [
            "zbog",
