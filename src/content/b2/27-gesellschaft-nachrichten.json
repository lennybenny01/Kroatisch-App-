  "sentences": [
    {
      "id": "s_27_01",
      "hr": "Vlada je donijela novi zakon.",
      "de": "Die Regierung hat ein neues Gesetz beschlossen."
    },
    {
      "id": "s_27_02",
      "hr": "Sljedeće godine su izbori.",
      "de": "Nächstes Jahr sind Wahlen."
    },
    {
      "id": "s_27_03",
      "hr": "Jesi li glasao?",
      "de": "Hast du gewählt?",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_27_04",
      "hr": "Građani imaju pravo glasati.",
      "de": "Die Bürger haben das Recht zu wählen."
    },
    {
      "id": "s_27_05",
      "hr": "Ministar je izjavio da je zadovoljan.",
      "de": "Der Minister erklärte, dass er zufrieden sei.",
      "grammar": "g_b2_neupravni",
      "note": "da + Zeit der direkten Rede"
    },
    {
      "id": "s_27_06",
      "hr": "Predsjednik je otvorio izložbu.",
      "de": "Der Präsident hat die Ausstellung eröffnet."
    },
    {
      "id": "s_27_07",
      "hr": "On tvrdi da to nije istina.",
      "de": "Er behauptet, dass das nicht stimmt.",
      "grammar": "g_b2_neupravni"
    },
    {
      "id": "s_27_08",
      "hr": "Rekao je da nema vremena.",
      "de": "Er sagte, dass er keine Zeit hat.",
      "grammar": "g_b2_neupravni",
      "note": "da + Präsens (kein Konjunktiv)"
    },
    {
      "id": "s_27_09",
      "hr": "Istraživanje je pokazalo zanimljive podatke.",
      "de": "Die Studie hat interessante Daten gezeigt."
    },
    {
      "id": "s_27_10",
      "hr": "Prema istraživanju, ljudi rade previše.",
      "de": "Laut der Studie arbeiten die Leute zu viel."
    },
    {
      "id": "s_27_11",
      "hr": "Trideset posto ljudi nema posao.",
      "de": "Dreißig Prozent der Leute haben keine Arbeit."
    },
    {
      "id": "s_27_12",
      "hr": "Nezaposlenost je velik problem.",
      "de": "Arbeitslosigkeit ist ein großes Problem."
    },
    {
      "id": "s_27_13",
      "hr": "Cijene uvijek rastu.",
      "de": "Die Preise steigen immer."
    },
    {
      "id": "s_27_14",
      "hr": "Vlada je smanjila poreze.",
      "de": "Die Regierung hat die Steuern gesenkt."
    },
    {
      "id": "s_27_15",
      "hr": "Plaće su povećane.",
      "de": "Die Gehälter wurden erhöht.",
      "grammar": "g_b2_pasiv"
    },
    {
      "id": "s_27_16",
      "hr": "Na trgu je bio prosvjed.",
      "de": "Auf dem Platz gab es eine Demonstration."
    },
    {
      "id": "s_27_17",
      "hr": "Tisuće ljudi su sudjelovale.",
      "de": "Tausende Menschen haben teilgenommen."
    },
    {
      "id": "s_27_18",
      "hr": "Grade novi most.",
      "de": "Sie bauen eine neue Brücke.",
      "grammar": "g_aspekt"
    },
    {
      "id": "s_27_19",
      "hr": "Most je izgrađen prošle godine.",
      "de": "Die Brücke wurde letztes Jahr gebaut.",
      "grammar": "g_b2_pasiv"
    },
    {
      "id": "s_27_20",
      "hr": "Dao je intervju za televiziju.",
      "de": "Er hat dem Fernsehen ein Interview gegeben."
    },
    {
      "id": "s_27_21",
      "hr": "Navodno je ministar bolestan.",
      "de": "Angeblich ist der Minister krank."
    },
    {
      "id": "s_27_22",
      "hr": "Službeno još nema odluke.",
      "de": "Offiziell gibt es noch keine Entscheidung.",
      "grammar": "g_genitiv"
    },
    {
      "id": "s_27_23",
      "hr": "Sigurnost je tema o kojoj se puno govori.",
      "de": "Sicherheit ist ein Thema, über das viel gesprochen wird.",
      "grammar": "g_b2_relativ",
      "note": "o + Lokativ: o kojoj"
    },
    {
      "id": "s_27_24",
      "hr": "To je sud u kojem radi moj brat.",
      "de": "Das ist das Gericht, in dem mein Bruder arbeitet.",
      "grammar": "g_b2_relativ",
      "note": "u + Lokativ: u kojem"
    },
    {
      "id": "s_27_25",
      "hr": "Manjina nije zadovoljna odlukom.",
      "de": "Die Minderheit ist mit der Entscheidung nicht zufrieden."
    },
    {
      "id": "s_27_26",
      "hr": "Stanovništvo grada u kojem živim raste.",
      "de": "Die Bevölkerung der Stadt, in der ich wohne, wächst.",
      "grammar": "g_b2_relativ"
    }
  ],
