  "sentences": [
    {
      "id": "s_13_01",
      "hr": "Čime se baviš?",
      "de": "Was machst du beruflich?",
      "grammar": "g_instrumental_beruf",
      "note": "Wörtlich: Womit beschäftigst du dich?"
    },
    {
      "id": "s_13_02",
      "hr": "Koje je Vaše zanimanje?",
      "de": "Was sind Sie von Beruf?"
    },
    {
      "id": "s_13_03",
      "hr": "Radim kao konobar.",
      "de": "Ich arbeite als Kellner.",
      "grammar": "g_instrumental_beruf",
      "note": "kao + Nominativ"
    },
    {
      "id": "s_13_04",
      "hr": "Radim u velikoj tvrtki.",
      "de": "Ich arbeite in einer großen Firma.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_13_05",
      "hr": "Imam dobru plaću.",
      "de": "Ich habe ein gutes Gehalt."
    },
    {
      "id": "s_13_06",
      "hr": "Radno vrijeme je od osam do četiri.",
      "de": "Die Arbeitszeit ist von acht bis vier."
    },
    {
      "id": "s_13_07",
      "hr": "Imam sastanak u deset.",
      "de": "Ich habe um zehn eine Besprechung."
    },
    {
      "id": "s_13_08",
      "hr": "Jesi li dobio moju poruku?",
      "de": "Hast du meine Nachricht bekommen?",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_13_09",
      "hr": "Pošalji mi poruku.",
      "de": "Schick mir eine Nachricht.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_13_10",
      "hr": "Nazovi me sutra.",
      "de": "Ruf mich morgen an.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_13_11",
      "hr": "Gdje si zaposlen?",
      "de": "Wo arbeitest du?",
      "note": "Wörtlich: Wo bist du angestellt?"
    },
    {
      "id": "s_13_12",
      "hr": "Sada sam nezaposlen.",
      "de": "Im Moment bin ich arbeitslos."
    },
    {
      "id": "s_13_13",
      "hr": "Tražim posao.",
      "de": "Ich suche Arbeit."
    },
    {
      "id": "s_13_14",
      "hr": "Imate li iskustva?",
      "de": "Haben Sie Erfahrung?",
      "grammar": "g_genitiv"
    },
    {
      "id": "s_13_15",
      "hr": "Sljedeći tjedan sam na godišnjem.",
      "de": "Nächste Woche bin ich im Urlaub.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_13_16",
      "hr": "Imam pauzu u podne.",
      "de": "Ich habe mittags Pause."
    },
    {
      "id": "s_13_17",
      "hr": "Danas radim drugu smjenu.",
      "de": "Heute arbeite ich in der Spätschicht.",
      "note": "Wörtlich: die zweite Schicht"
    },
    {
      "id": "s_13_18",
      "hr": "Posao je naporan.",
      "de": "Die Arbeit ist anstrengend."
    },
    {
      "id": "s_13_19",
      "hr": "Moj posao je zanimljiv.",
      "de": "Meine Arbeit ist interessant."
    },
    {
      "id": "s_13_20",
      "hr": "Sastanak je bio dosadan.",
      "de": "Die Besprechung war langweilig.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_13_21",
      "hr": "Zadovoljan sam poslom.",
      "de": "Ich bin mit der Arbeit zufrieden.",
      "grammar": "g_instrumental_beruf",
      "note": "posao → poslom (Instrumental)"
    },
    {
      "id": "s_13_22",
      "hr": "Posao počinje u osam.",
      "de": "Die Arbeit beginnt um acht.",
      "grammar": "g_aspekt_praesens"
    },
    {
      "id": "s_13_23",
      "hr": "Kada si počeo raditi?",
      "de": "Wann hast du angefangen zu arbeiten?",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_13_24",
      "hr": "Kad završiš, nazovi me.",
      "de": "Wenn du fertig bist, ruf mich an.",
      "grammar": "g_aspekt_praesens"
    },
    {
      "id": "s_13_25",
      "hr": "Oprostite, kasnim.",
      "de": "Entschuldigung, ich komme zu spät.",
      "grammar": "g_aspekt_praesens"
    }
  ],
