      "de": "Wo ist die Kasse?"
    },
    {
      "id": "s_08_09",
      "hr": "Mogu li platiti karticom?",
      "de": "Kann ich mit Karte zahlen?",
      "grammar": "g_instrumental",
      "note": "kartica → karticom (Instrumental)"
    },
    {
      "id": "s_08_10",
      "hr": "Nemam gotovine.",
      "de": "Ich habe kein Bargeld.",
      "grammar": "g_genitiv",
      "note": "Nach Verneinung oft Genitiv"
    },
    {
      "id": "s_08_11",
      "hr": "Trebate li vrećicu?",
      "de": "Brauchen Sie eine Tüte?",
      "grammar": "g_modalverben_a2"
    },
    {
      "id": "s_08_12",
      "hr": "Smijem li platiti karticom?",
      "de": "Darf ich mit Karte zahlen?",
      "grammar": "g_modalverben_a2"
    },
    {
      "id": "s_08_13",
      "hr": "Mogu li probati?",
      "de": "Kann ich das anprobieren?",
      "grammar": "g_modalverben_a2"
    },
    {
      "id": "s_08_14",
      "hr": "Koju veličinu trebate?",
      "de": "Welche Größe brauchen Sie?"
    },
    {
      "id": "s_08_15",
      "hr": "Koji broj nosite?",
      "de": "Welche Schuhgröße haben Sie?",
      "note": "Wörtlich: Welche Nummer tragen Sie?"
    },
    {
      "id": "s_08_16",
      "hr": "Koliko košta ovaj kruh?",
      "de": "Was kostet dieses Brot?",
      "grammar": "g_ovaj_taj"
    },
    {
      "id": "s_08_17",
      "hr": "Ova majica je skupa.",
      "de": "Dieses T-Shirt ist teuer.",
      "grammar": "g_ovaj_taj"
    },
    {
      "id": "s_08_18",
      "hr": "Koliko košta taj sir?",
      "de": "Was kostet der Käse da?",
      "grammar": "g_ovaj_taj"
    },
    {
      "id": "s_08_19",
      "hr": "Ta haljina je lijepa.",
      "de": "Das Kleid da ist schön.",
      "grammar": "g_ovaj_taj"
    },
    {
      "id": "s_08_20",
      "hr": "Imate li crvenu majicu?",
      "de": "Haben Sie ein rotes T-Shirt?",
      "grammar": "g_akkusativ"
    },
    {
      "id": "s_08_21",
      "hr": "Trgovina je otvorena do osam.",
      "de": "Der Laden hat bis acht geöffnet."
    },
    {
      "id": "s_08_22",
      "hr": "Trebate li još nešto?",
      "de": "Brauchen Sie noch etwas?"
    },
    {
      "id": "s_08_23",
      "hr": "To je ukupno dvadeset eura.",
      "de": "Das macht insgesamt zwanzig Euro."
    },
    {
      "id": "s_08_24",
      "hr": "Mogu li ovo vratiti?",
      "de": "Kann ich das zurückgeben?",
      "grammar": "g_modalverben_a2"
    },
    {
      "id": "s_08_25",
      "hr": "Ima li popusta?",
      "de": "Gibt es Rabatt?",
      "grammar": "g_genitiv",
      "note": "Nach „ima li“: Genitiv (popust → popusta)"
    }
