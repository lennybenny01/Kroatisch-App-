{
  "id": "a2_08",
  "order": 8,
  "level": "A2",
  "title": "Einkaufen",
  "description": "Auf dem Markt, im Laden und beim Kleiderkauf: nach Preisen fragen, Mengen angeben, bezahlen.",
  "canDo": [
    "Ich kann nach Preisen fragen und Preise verstehen.",
    "Ich kann Mengen angeben: ein Kilo, ein Liter, zwei Stück.",
    "Ich kann Kleidung in meiner Größe und Farbe verlangen.",
    "Ich kann bar oder mit Karte bezahlen und etwas zurückgeben."
  ],
  "grammar": [
    {
      "id": "g_genitiv",
      "title": "Genitiv Singular",
      "summary": "Mengen, Preise, „ohne“, „von“, „bis“ – überall Genitiv.",
      "body": [
        "Den Genitiv brauchst du ständig:",
        "• nach Mengen: litra mlijeka, kila jabuka, komad sira",
        "• nach Präpositionen wie bez, iz, od, do, kod, blizu, nakon, prije, ispred, iza, pored",
        "• nach den Zahlen 2, 3, 4: dva komada",
        "• nach Verneinung oft statt des Akkusativs: Nemam gotovine. – Ich habe kein Bargeld."
      ],
