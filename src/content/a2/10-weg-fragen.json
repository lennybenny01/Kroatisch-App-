  "sentences": [
    {
      "id": "s_10_01",
      "hr": "Gdje se nalazi kolodvor?",
      "de": "Wo ist der Bahnhof?",
      "note": "Wörtlich: Wo befindet sich der Bahnhof?"
    },
    {
      "id": "s_10_02",
      "hr": "Skrenite lijevo.",
      "de": "Biegen Sie links ab.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_10_03",
      "hr": "Na semaforu skrenite desno.",
      "de": "An der Ampel biegen Sie rechts ab.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_10_04",
      "hr": "Na raskrižju idite ravno.",
      "de": "An der Kreuzung geradeaus.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_10_05",
      "hr": "Hotel je iza crkve.",
      "de": "Das Hotel ist hinter der Kirche.",
      "grammar": "g_mjesto_genitiv",
      "note": "crkva → iza crkve"
    },
    {
      "id": "s_10_06",
      "hr": "Banka je iza ugla.",
      "de": "Die Bank ist um die Ecke.",
      "grammar": "g_mjesto_genitiv"
    },
    {
      "id": "s_10_07",
      "hr": "Čekam ispred hotela.",
      "de": "Ich warte vor dem Hotel.",
      "grammar": "g_mjesto_genitiv"
    },
    {
      "id": "s_10_08",
      "hr": "Pošta je pored banke.",
      "de": "Die Post ist neben der Bank.",
      "grammar": "g_mjesto_genitiv"
    },
    {
      "id": "s_10_09",
      "hr": "Ljekarna je preko puta pošte.",
      "de": "Die Apotheke ist gegenüber der Post.",
      "grammar": "g_mjesto_genitiv"
    },
    {
      "id": "s_10_10",
      "hr": "Kafić je između banke i pošte.",
      "de": "Das Café ist zwischen Bank und Post.",
      "grammar": "g_mjesto_genitiv"
    },
    {
      "id": "s_10_11",
      "hr": "Prijeđite ulicu.",
      "de": "Gehen Sie über die Straße.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_10_12",
      "hr": "Živim u centru.",
      "de": "Ich wohne im Zentrum.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_10_13",
      "hr": "Sto metara ravno.",
      "de": "Hundert Meter geradeaus.",
      "grammar": "g_zahlen_faelle"
    },
    {
      "id": "s_10_14",
      "hr": "Otprilike deset minuta pješice.",
      "de": "Ungefähr zehn Minuten zu Fuß."
    },
    {
      "id": "s_10_15",
      "hr": "Pitajte konobara.",
      "de": "Fragen Sie den Kellner.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_10_16",
      "hr": "Možete li mi pokazati na karti?",
      "de": "Können Sie es mir auf der Karte zeigen?",
      "grammar": "g_dativ"
    },
    {
      "id": "s_10_17",
      "hr": "Gdje je stanica?",
      "de": "Wo ist die Haltestelle?"
    },
    {
      "id": "s_10_18",
      "hr": "Sljedeći, molim!",
      "de": "Der Nächste, bitte!"
    },
    {
      "id": "s_10_19",
      "hr": "Gdje moram izaći?",
      "de": "Wo muss ich aussteigen?",
      "grammar": "g_modalverben_a2"
    },
    {
      "id": "s_10_20",
      "hr": "Uđite!",
      "de": "Herein!",
      "grammar": "g_imperativ",
      "note": "Wörtlich: Treten Sie ein!"
    },
    {
      "id": "s_10_21",
      "hr": "Gdje je izlaz?",
      "de": "Wo ist der Ausgang?"
    },
    {
      "id": "s_10_22",
      "hr": "Stan je na prvom katu.",
      "de": "Die Wohnung ist im ersten Stock.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_10_23",
      "hr": "Idite dizalom.",
      "de": "Nehmen Sie den Aufzug.",
      "grammar": "g_instrumental",
      "note": "Wörtlich: Gehen Sie mit dem Aufzug."
    },
    {
      "id": "s_10_24",
      "hr": "Dolje je parkiralište.",
      "de": "Unten ist ein Parkplatz."
    },
    {
      "id": "s_10_25",
      "hr": "Nemojte ići pješice, daleko je.",
      "de": "Gehen Sie nicht zu Fuß, es ist weit.",
      "grammar": "g_imperativ"
    }
  ],
