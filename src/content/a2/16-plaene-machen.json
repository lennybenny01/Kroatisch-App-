  "id": "a2_16",
  "order": 16,
  "level": "A2",
  "title": "Pläne machen",
  "description": "Verabredungen treffen, zu- und absagen, Termine verschieben – mit Futur und dem Verbaspekt.",
  "canDo": [
    "Ich kann fragen, was jemand vorhat, und von meinen Plänen erzählen.",
    "Ich kann mich verabreden und einen Treffpunkt ausmachen.",
    "Ich kann zusagen, absagen und einen Termin verschieben.",
    "Ich kann Bedingungen ausdrücken: wenn du Zeit hast …"
  ],
  "grammar": [
    {
      "id": "g_futur_aspekt",
      "title": "Futur mit Aspekt",
      "summary": "Gledat ću film. – Pogledat ću film.",
      "body": [
        "Auch im Futur wählst du den Aspekt: Gledat ću TV cijelu večer. (Vorgang) – Pogledat ću film. (einen ganzen Film, abgeschlossen)",
        "Verneinung: Neću moći doći. – Ich werde nicht kommen können.",
        "Für feste Pläne nimmt man oft einfach das Präsens: Idući tjedan idem u Split."
      ]
    },
    {
      "id": "g_ako",
      "title": "Bedingungen mit ako",
      "summary": "Ako imaš vremena, dođi!",
      "body": [
        "ako = wenn / falls. Danach steht meist das Präsens: Ako imaš vremena, dođi.",
        "Mit vollendeten Verben im Präsens geht es um die Zukunft: Ako završim rano, nazvat ću te.",
        "kad (wenn, sobald) funktioniert genauso: Kad dođeš, javi se."
      ]
    }
  ],
