  "sentences": [
    {
      "id": "s_16_01",
      "hr": "Što planiraš za vikend?",
      "de": "Was hast du am Wochenende vor?"
    },
    {
      "id": "s_16_02",
      "hr": "Imaš li planove za vikend?",
      "de": "Hast du Pläne fürs Wochenende?"
    },
    {
      "id": "s_16_03",
      "hr": "Ako imaš vremena, dođi.",
      "de": "Wenn du Zeit hast, komm vorbei.",
      "grammar": "g_ako"
    },
    {
      "id": "s_16_04",
      "hr": "Onda se vidimo sutra.",
      "de": "Dann sehen wir uns morgen."
    },
    {
      "id": "s_16_05",
      "hr": "Poslije posla idem kući.",
      "de": "Nach der Arbeit gehe ich nach Hause.",
      "grammar": "g_genitiv"
    },
    {
      "id": "s_16_06",
      "hr": "Nazovi me kasnije.",
      "de": "Ruf mich später an."
    },
    {
      "id": "s_16_07",
      "hr": "Nađimo se u osam.",
      "de": "Treffen wir uns um acht.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_16_08",
      "hr": "Idemo u kino?",
      "de": "Gehen wir ins Kino?",
      "grammar": "g_wohin"
    },
    {
      "id": "s_16_09",
      "hr": "Večeras idemo u kazalište.",
      "de": "Heute Abend gehen wir ins Theater.",
      "grammar": "g_wohin"
    },
    {
      "id": "s_16_10",
      "hr": "Imam karte za koncert.",
      "de": "Ich habe Karten fürs Konzert."
    },
    {
      "id": "s_16_11",
      "hr": "U nedjelju idemo na izlet.",
      "de": "Am Sonntag machen wir einen Ausflug.",
      "grammar": "g_wohin"
    },
    {
      "id": "s_16_12",
      "hr": "Pozvala sam Anu.",
      "de": "Ich habe Ana eingeladen.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_16_13",
      "hr": "U subotu imamo zabavu.",
      "de": "Am Samstag feiern wir eine Party."
    },
    {
      "id": "s_16_14",
      "hr": "Sigurno ću doći.",
      "de": "Ich komme bestimmt.",
      "grammar": "g_futur"
    },
    {
      "id": "s_16_15",
      "hr": "Nažalost, neću moći doći.",
      "de": "Leider kann ich nicht kommen.",
      "grammar": "g_futur_aspekt"
    },
    {
      "id": "s_16_16",
      "hr": "Dogovorimo se za subotu.",
      "de": "Machen wir es für Samstag aus."
    },
    {
      "id": "s_16_17",
      "hr": "Dogovoreno!",
      "de": "Abgemacht!"
    },
    {
      "id": "s_16_18",
      "hr": "Još nisam odlučila.",
      "de": "Ich habe mich noch nicht entschieden.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_16_19",
      "hr": "Moram otkazati sastanak.",
      "de": "Ich muss das Treffen absagen.",
      "grammar": "g_aspekt"
    },
    {
      "id": "s_16_20",
      "hr": "Možemo li pomaknuti termin?",
      "de": "Können wir den Termin verschieben?"
    },
    {
      "id": "s_16_21",
      "hr": "Večeras ću pogledati film.",
      "de": "Heute Abend schaue ich mir einen Film an.",
      "grammar": "g_futur_aspekt"
    },
    {
      "id": "s_16_22",
      "hr": "Što ćeš napraviti za večeru?",
      "de": "Was machst du zum Abendessen?",
      "grammar": "g_futur_aspekt"
    },
    {
      "id": "s_16_23",
      "hr": "Ostat ću kod kuće.",
      "de": "Ich bleibe zu Hause.",
      "grammar": "g_futur"
    },
    {
      "id": "s_16_24",
      "hr": "Za vikend ću se odmoriti.",
      "de": "Am Wochenende ruhe ich mich aus.",
      "grammar": "g_futur"
    },
    {
      "id": "s_16_25",
      "hr": "Idući tjedan idem u Split.",
      "de": "Nächste Woche fahre ich nach Split.",
      "grammar": "g_futur_aspekt",
      "note": "Feste Pläne oft im Präsens"
    }
  ],
