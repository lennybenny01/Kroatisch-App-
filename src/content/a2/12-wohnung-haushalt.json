      "id": "s_12_10",
      "hr": "Tko pere suđe?",
      "de": "Wer spült ab?",
      "grammar": "g_aspekt"
    },
    {
      "id": "s_12_11",
      "hr": "Moram oprati suđe.",
      "de": "Ich muss abspülen.",
      "grammar": "g_aspekt",
      "note": "vollendet: das Geschirr soll sauber werden"
    },
    {
      "id": "s_12_12",
      "hr": "Kuham ručak.",
      "de": "Ich koche das Mittagessen.",
      "grammar": "g_aspekt",
      "note": "unvollendet: ich bin dabei"
    },
    {
      "id": "s_12_13",
      "hr": "Skuhala sam kavu.",
      "de": "Ich habe Kaffee gekocht.",
      "grammar": "g_perfekt_aspekt",
      "note": "vollendet: der Kaffee ist fertig"
    },
    {
      "id": "s_12_14",
      "hr": "Subotom čistimo stan.",
      "de": "Samstags putzen wir die Wohnung.",
      "grammar": "g_aspekt",
      "note": "Gewohnheit: unvollendet"
    },
    {
      "id": "s_12_15",
      "hr": "Očistio sam kuhinju.",
      "de": "Ich habe die Küche sauber gemacht.",
      "grammar": "g_perfekt_aspekt"
    },
    {
      "id": "s_12_16",
      "hr": "Moraš pospremiti sobu.",
      "de": "Du musst das Zimmer aufräumen.",
      "grammar": "g_aspekt"
    },
    {
      "id": "s_12_17",
      "hr": "Tko će iznijeti smeće?",
      "de": "Wer bringt den Müll raus?",
      "grammar": "g_futur"
    },
    {
      "id": "s_12_18",
      "hr": "Koliko je stanarina?",
      "de": "Wie hoch ist die Miete?"
    },
    {
      "id": "s_12_19",
      "hr": "Tko plaća?",
      "de": "Wer zahlt?",
      "grammar": "g_aspekt"
    },
    {
      "id": "s_12_20",
      "hr": "Stanarinu plaćam mjesečno.",
      "de": "Die Miete zahle ich monatlich.",
      "grammar": "g_aspekt"
    },
    {
      "id": "s_12_21",
      "hr": "Grijanje ne radi.",
      "de": "Die Heizung funktioniert nicht.",
      "note": "raditi = auch „funktionieren“"
    },
    {
      "id": "s_12_22",
      "hr": "Nema struje.",
      "de": "Es gibt keinen Strom.",
      "grammar": "g_genitiv",
      "note": "nema + Genitiv"
    },
    {
      "id": "s_12_23",
      "hr": "Možete li to popraviti?",
      "de": "Können Sie das reparieren?"
    },
    {
      "id": "s_12_24",
      "hr": "Uselili smo se u novi stan.",
      "de": "Wir sind in eine neue Wohnung gezogen.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_12_25",
      "hr": "Prošli tjedan sam bio na moru.",
      "de": "Letzte Woche war ich am Meer.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_12_26",
      "hr": "Ručak je gotov!",
      "de": "Das Mittagessen ist fertig!"
    },
    {
      "id": "s_12_27",
      "hr": "Već sam skuhala ručak.",
      "de": "Ich habe das Mittagessen schon gekocht.",
      "grammar": "g_perfekt_aspekt"
    }
  ],
  "addForms": {
    "w_subota": [
      "subotom"
    ],
    "w_mjesec": [
      "mjesecu"
    ]
  }
}
