            "zahlen"
          ],
          [
            "otvarati",
            "otvoriti",
            "öffnen"
          ]
        ]
      }
    },
    {
      "id": "g_perfekt_aspekt",
      "title": "Perfekt mit Aspekt",
      "summary": "Čistio sam. – Očistio sam kuhinju.",
      "body": [
        "Čistio sam cijeli dan. – Ich habe den ganzen Tag geputzt (Vorgang).",
        "Očistio sam kuhinju. – Ich habe die Küche sauber gemacht (Ergebnis: sie ist jetzt sauber).",
        "Frage nach dem Ergebnis: Jesi li oprao suđe? – Hast du (schon) abgespült?"
      ]
    }
  ],
