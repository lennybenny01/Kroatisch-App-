      "id": "s_09_17",
      "hr": "Možete li mi donijeti još jedan tanjur?",
      "de": "Können Sie mir noch einen Teller bringen?",
      "grammar": "g_dativ"
    },
    {
      "id": "s_09_18",
      "hr": "Za desert ću sladoled.",
      "de": "Zum Nachtisch nehme ich ein Eis.",
      "grammar": "g_futur"
    },
    {
      "id": "s_09_19",
      "hr": "Hvala, zadržite ostatak.",
      "de": "Danke, stimmt so.",
      "note": "Wörtlich: Behalten Sie den Rest."
    },
    {
      "id": "s_09_20",
      "hr": "Ostavit ću napojnicu.",
      "de": "Ich lasse Trinkgeld da.",
      "grammar": "g_futur"
    },
    {
      "id": "s_09_21",
      "hr": "Konobarice, račun, molim!",
      "de": "Die Rechnung bitte! (zur Kellnerin)",
      "grammar": "g_vokativ",
      "note": "konobarica → konobarice (Anrede)"
    },
    {
      "id": "s_09_22",
      "hr": "Deset ćevapa, molim.",
      "de": "Zehn Ćevapi, bitte.",
      "grammar": "g_zahlen_faelle"
    },
    {
      "id": "s_09_23",
      "hr": "Burek sa sirom, molim.",
      "de": "Burek mit Käse, bitte.",
      "grammar": "g_instrumental",
      "note": "vor s: sa statt s"
    },
    {
      "id": "s_09_24",
      "hr": "Popit ću još jedno pivo.",
      "de": "Ich trinke noch ein Bier.",
      "grammar": "g_futur",
      "note": "popiti = (aus)trinken, vollendet"
    },
    {
      "id": "s_09_25",
      "hr": "Pojest ću sve.",
      "de": "Ich esse alles auf.",
      "grammar": "g_futur"
    }
  ],
