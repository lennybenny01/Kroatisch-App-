  "sentences": [
    {
      "id": "s_17_01",
      "hr": "Gdje ljetuješ?",
      "de": "Wo machst du Sommerurlaub?"
    },
    {
      "id": "s_17_02",
      "hr": "Na odmoru smo.",
      "de": "Wir sind im Urlaub.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_17_03",
      "hr": "Iznajmili smo apartman.",
      "de": "Wir haben eine Ferienwohnung gemietet.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_17_04",
      "hr": "Smještaj je bio odličan.",
      "de": "Die Unterkunft war ausgezeichnet.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_17_05",
      "hr": "Idemo trajektom na otok.",
      "de": "Wir fahren mit der Fähre auf die Insel.",
      "grammar": "g_instrumental"
    },
    {
      "id": "s_17_06",
      "hr": "Brod je u luci.",
      "de": "Das Schiff ist im Hafen.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_17_07",
      "hr": "Idemo se kupati!",
      "de": "Gehen wir baden!"
    },
    {
      "id": "s_17_08",
      "hr": "Cijeli dan smo se sunčali.",
      "de": "Wir haben uns den ganzen Tag gesonnt.",
      "grammar": "g_pricati",
      "note": "Hintergrund: unvollendet"
    },
    {
      "id": "s_17_09",
      "hr": "Dvije ležaljke, molim.",
      "de": "Zwei Liegen, bitte.",
      "grammar": "g_zahlen_faelle"
    },
    {
      "id": "s_17_10",
      "hr": "Koliko košta suncobran?",
      "de": "Was kostet ein Sonnenschirm?"
    },
    {
      "id": "s_17_11",
      "hr": "Imaš li kremu za sunčanje?",
      "de": "Hast du Sonnencreme?"
    },
    {
      "id": "s_17_12",
      "hr": "Zaboravio sam ručnik.",
      "de": "Ich habe mein Handtuch vergessen.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_17_13",
      "hr": "Na plaži je pijesak.",
      "de": "Am Strand ist Sand.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_17_14",
      "hr": "Danas su veliki valovi.",
      "de": "Heute sind hohe Wellen."
    },
    {
      "id": "s_17_15",
      "hr": "Znaš li roniti?",
      "de": "Kannst du tauchen?",
      "grammar": "g_modalverben"
    },
    {
      "id": "s_17_16",
      "hr": "Stari grad je vrlo lijep.",
      "de": "Die Altstadt ist sehr schön."
    },
    {
      "id": "s_17_17",
      "hr": "Razgledali smo stari grad.",
      "de": "Wir haben die Altstadt besichtigt.",
      "grammar": "g_pricati",
      "note": "vollendet: abgeschlossen"
    },
    {
      "id": "s_17_18",
      "hr": "Jeste li bili na zidinama?",
      "de": "Wart ihr auf der Stadtmauer?",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_17_19",
      "hr": "Bilo je tako lijepo!",
      "de": "Es war so schön!",
      "grammar": "g_pricati"
    },
    {
      "id": "s_17_20",
      "hr": "Ovdje je jedna lijepa uvala.",
      "de": "Hier gibt es eine schöne Bucht."
    },
    {
      "id": "s_17_21",
      "hr": "Navečer jedemo u konobi.",
      "de": "Abends essen wir in der Konoba.",
      "grammar": "g_lokativ"
    },
    {
      "id": "s_17_22",
      "hr": "Smijem li fotografirati?",
      "de": "Darf ich fotografieren?",
      "grammar": "g_modalverben_a2"
    },
    {
      "id": "s_17_23",
      "hr": "Odmor je brzo prošao.",
      "de": "Der Urlaub ist schnell vergangen.",
      "grammar": "g_pricati"
    },
    {
      "id": "s_17_24",
      "hr": "Moram spakirati kofer.",
      "de": "Ich muss den Koffer packen.",
      "grammar": "g_aspekt"
    },
    {
      "id": "s_17_25",
      "hr": "Imate li putovnicu?",
      "de": "Haben Sie einen Reisepass?"
    },
    {
      "id": "s_17_26",
      "hr": "Daleko je do granice.",
      "de": "Es ist weit bis zur Grenze.",
      "grammar": "g_genitiv"
    },
    {
      "id": "s_17_27",
      "hr": "Na granici je bila gužva.",
      "de": "An der Grenze war viel Verkehr.",
      "grammar": "g_pricati"
    }
  ],
  "addForms": {
    "w_moj": [
      "mojom"
    ]
  }
}
