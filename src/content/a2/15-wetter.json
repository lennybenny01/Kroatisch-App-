  "sentences": [
    {
      "id": "s_15_01",
      "hr": "Kakvo je vrijeme?",
      "de": "Wie ist das Wetter?",
      "grammar": "g_vrijeme"
    },
    {
      "id": "s_15_02",
      "hr": "Sunčano je.",
      "de": "Es ist sonnig.",
      "grammar": "g_vrijeme"
    },
    {
      "id": "s_15_03",
      "hr": "Bit će kiše.",
      "de": "Es wird regnen.",
      "grammar": "g_vrijeme",
      "note": "Wörtlich: Es wird Regen geben (Genitiv)."
    },
    {
      "id": "s_15_04",
      "hr": "Pada kiša.",
      "de": "Es regnet.",
      "grammar": "g_vrijeme",
      "note": "Wörtlich: Regen fällt."
    },
    {
      "id": "s_15_05",
      "hr": "Pada snijeg.",
      "de": "Es schneit.",
      "grammar": "g_vrijeme"
    },
    {
      "id": "s_15_06",
      "hr": "Danas je jak vjetar.",
      "de": "Heute ist starker Wind."
    },
    {
      "id": "s_15_07",
      "hr": "Puše vjetar.",
      "de": "Es ist windig.",
      "grammar": "g_vrijeme",
      "note": "Wörtlich: Der Wind bläst."
    },
    {
      "id": "s_15_08",
      "hr": "Puše bura.",
      "de": "Die Bora weht.",
      "grammar": "g_vrijeme"
    },
    {
      "id": "s_15_09",
      "hr": "Ujutro je bila magla.",
      "de": "Morgens war Nebel.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_15_10",
      "hr": "Jučer je bila oluja.",
      "de": "Gestern war ein Gewitter.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_15_11",
      "hr": "Vruće je!",
      "de": "Es ist heiß!",
      "grammar": "g_vrijeme"
    },
    {
      "id": "s_15_12",
      "hr": "Danas je trideset stupnjeva.",
      "de": "Heute sind es dreißig Grad.",
      "grammar": "g_zahlen_faelle"
    },
    {
      "id": "s_15_13",
      "hr": "Kakva je prognoza za sutra?",
      "de": "Wie ist die Vorhersage für morgen?"
    },
    {
      "id": "s_15_14",
      "hr": "Uzmi kišobran!",
      "de": "Nimm einen Regenschirm mit!",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_15_15",
      "hr": "U proljeće je lijepo.",
      "de": "Im Frühling ist es schön.",
      "grammar": "g_godisnja_doba"
    },
    {
      "id": "s_15_16",
      "hr": "Ljeti je vruće.",
      "de": "Im Sommer ist es heiß.",
      "grammar": "g_godisnja_doba"
    },
    {
      "id": "s_15_17",
      "hr": "U jesen pada kiša.",
      "de": "Im Herbst regnet es.",
      "grammar": "g_godisnja_doba"
    },
    {
      "id": "s_15_18",
      "hr": "Zimi je hladno.",
      "de": "Im Winter ist es kalt.",
      "grammar": "g_godisnja_doba"
    },
    {
      "id": "s_15_19",
      "hr": "Vrijeme se promijenilo.",
      "de": "Das Wetter hat sich geändert.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_15_20",
      "hr": "Nadam se da će biti sunčano.",
      "de": "Ich hoffe, es wird sonnig.",
      "grammar": "g_futur"
    },
    {
      "id": "s_15_21",
      "hr": "Prekosutra će biti toplo.",
      "de": "Übermorgen wird es warm.",
      "grammar": "g_futur"
    },
    {
      "id": "s_15_22",
      "hr": "Večeras će padati kiša.",
      "de": "Heute Abend wird es regnen.",
      "grammar": "g_futur"
    },
    {
      "id": "s_15_23",
      "hr": "Jutros je bilo hladno.",
      "de": "Heute Morgen war es kalt.",
      "grammar": "g_vrijeme",
      "note": "bilo: neutrale Form"
    },
    {
      "id": "s_15_24",
      "hr": "Cijeli dan pada kiša.",
      "de": "Es regnet den ganzen Tag."
    },
    {
      "id": "s_15_25",
      "hr": "Danas je ugodno.",
      "de": "Heute ist es angenehm.",
      "grammar": "g_vrijeme"
