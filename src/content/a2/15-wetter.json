  "level": "A2",
  "title": "Wetter",
  "description": "Über das Wetter sprechen – in Gegenwart, Vergangenheit und Zukunft, mit Bura und Jugo.",
  "canDo": [
    "Ich kann sagen, wie das Wetter ist, war und wird.",
    "Ich kann die Jahreszeiten nennen.",
    "Ich kann eine Wettervorhersage grob verstehen.",
    "Ich kann sagen, ob mir warm oder kalt ist."
  ],
  "grammar": [
    {
      "id": "g_vrijeme",
      "title": "Wetter: unpersönliche Sätze",
      "summary": "Hladno je. – Bilo je hladno. – Bit će hladno.",
      "body": [
        "Viele Wettersätze haben kein Subjekt. Das Adjektiv steht in der neutralen Form auf -o: Hladno je. Toplo je. Sunčano je.",
        "Perfekt: Bilo je hladno. (bilo = neutral) · Futur: Bit će toplo. (biti → bit će)",
        "Regen und Wind „fallen“ und „blasen“: Pada kiša. Pada snijeg. Puše bura. – Perfekt: Padala je kiša.",
        "Persönlich (mir ist …) mit Dativ: Hladno mi je. Vruće mi je."
      ]
    },
    {
      "id": "g_godisnja_doba",
      "title": "Jahreszeiten",
      "summary": "u proljeće · ljeti · u jesen · zimi",
      "body": [
        "Auf die Frage „wann?“ sagt man u + Akkusativ oder benutzt eine Adverbform:"
      ],
      "table": {
        "head": [
          "Jahreszeit",
          "im …"
        ],
        "rows": [
          [
            "proljeće (Frühling)",
            "u proljeće"
          ],
          [
            "ljeto (Sommer)",
            "ljeti / u ljeto"
          ],
          [
            "jesen (Herbst)",
            "u jesen"
          ],
          [
            "zima (Winter)",
            "zimi / u zimu"
          ]
        ]
      }
    }
  ],
