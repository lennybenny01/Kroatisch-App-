      "de": "Ich habe Rückenschmerzen.",
      "grammar": "g_boli_me",
      "note": "Plural: bole"
    },
    {
      "id": "s_11_06",
      "hr": "Imam temperaturu.",
      "de": "Ich habe Fieber.",
      "grammar": "g_akkusativ"
    },
    {
      "id": "s_11_07",
      "hr": "Prehlađena sam.",
      "de": "Ich bin erkältet.",
      "note": "Frau: prehlađena · Mann: prehlađen"
    },
    {
      "id": "s_11_08",
      "hr": "Trebam lijek.",
      "de": "Ich brauche ein Medikament."
