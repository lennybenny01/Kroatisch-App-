    },
    {
      "id": "s_11_11",
      "hr": "Uzmite tabletu nakon jela.",
      "de": "Nehmen Sie die Tablette nach dem Essen.",
      "grammar": "g_genitiv"
    },
    {
      "id": "s_11_12",
      "hr": "Pijte ovo prije jela.",
      "de": "Trinken Sie das vor dem Essen.",
      "grammar": "g_imperativ"
    },
    {
      "id": "s_11_13",
      "hr": "Trebam termin kod liječnika.",
