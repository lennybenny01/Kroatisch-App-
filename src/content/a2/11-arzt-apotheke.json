  "grammar": [
    {
      "id": "g_perfekt",
      "title": "Perfekt: Vergangenheit",
      "summary": "biti (Kurzform) + l-Partizip: Bio sam kod liječnika.",
      "body": [
        "Das Perfekt ist DIE Vergangenheitsform im gesprochenen Kroatisch. Du bildest es mit den Kurzformen von biti und dem l-Partizip.",
        "Das l-Partizip richtet sich nach dem Geschlecht: Mann pao, Frau pala, Mehrzahl pali. Ein Mann sagt also „Pao sam“, eine Frau „Pala sam“.",
        "Die Kurzform steht an zweiter Stelle: Pao sam. · Jučer sam bio bolestan. · Ja sam bio kod liječnika.",
        "Verneint mit nisam, nisi, nije …: Nisam spavao. Frage: Jesi li bio kod liječnika? · Što se dogodilo?"
      ],
      "table": {
        "head": [
          "",
          "Mann",
          "Frau",
          "Mehrzahl"
        ],
        "rows": [
          [
            "ja / mi",
            "bio sam",
            "bila sam",
            "bili smo"
          ],
          [
            "ti / vi",
            "bio si",
            "bila si",
            "bili ste"
          ],
          [
            "on / ona / oni",
            "bio je",
            "bila je",
            "bili su"
          ]
        ]
      }
    },
    {
      "id": "g_l_partizip",
      "title": "So bildest du das l-Partizip",
      "summary": "Infinitiv ohne -ti, dann -o / -la / -li",
      "body": [
        "Regelmäßig: raditi → radio, radila · spavati → spavao, spavala · piti → pio, pila.",
        "Unregelmäßig sind vor allem die Verben auf -ći und ein paar häufige Verben – am besten auswendig lernen:"
      ],
      "table": {
        "head": [
          "Infinitiv",
