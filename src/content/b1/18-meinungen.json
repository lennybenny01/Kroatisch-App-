  "title": "Meinungen äußern",
  "description": "Die eigene Meinung sagen, zustimmen und widersprechen, Gründe nennen und abwägen.",
  "canDo": [
    "Ich kann meine Meinung sagen und begründen.",
    "Ich kann zustimmen, widersprechen und abwägen.",
    "Ich kann Dinge vergleichen: besser, schlechter, am besten.",
    "Ich kann in einer Diskussion nachfragen."
  ],
  "grammar": [
    {
      "id": "g_b1_misljenje",
      "title": "Meinungen äußern",
      "summary": "Mislim da … · Po mom mišljenju … · Slažem se. / Ne slažem se.",
      "body": [
        "Nach Verben des Meinens folgt da + Präsens: Mislim da je to dobro. Smatram da imaš pravo. Sumnjam da je to istina.",
        "Abwägen: s jedne strane … s druge strane … (einerseits … andererseits).",
        "Zustimmen: Slažem se. Imaš pravo. Svakako! – Widersprechen: Ne slažem se. To nije istina. Nikako!"
      ],
      "table": {
        "head": [
          "Kroatisch",
          "Deutsch"
        ],
        "rows": [
          [
            "Mislim da …",
            "Ich glaube, dass …"
          ],
          [
            "Po mom mišljenju …",
            "Meiner Meinung nach …"
          ],
          [
            "Smatram da …",
            "Ich halte es für …"
          ],
          [
            "Slažem se s tobom.",
            "Ich stimme dir zu."
          ],
          [
            "Ne slažem se.",
            "Ich bin anderer Meinung."
          ],
          [
            "Imaš pravo.",
            "Du hast recht."
          ]
        ]
      }
    },
    {
      "id": "g_b1_veznici",
      "title": "Gründe und Gegensätze",
      "summary": "jer · zato što · zato · iako · dakle",
      "body": [
        "jer und zato što = weil: Učim hrvatski zato što volim Hrvatsku.",
        "zato = deshalb (Folge): Umoran sam, zato idem kući.",
        "iako = obwohl: Iako je skupo, kupit ću to.",
        "dakle = also (Schlussfolgerung)."
      ]
    },
