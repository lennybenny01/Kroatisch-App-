  "sentences": [
    {
      "id": "s_18_01",
      "hr": "To je samo moje mišljenje.",
      "de": "Das ist nur meine Meinung.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_02",
      "hr": "Po mom mišljenju, to nije dobro.",
      "de": "Meiner Meinung nach ist das nicht gut.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_03",
      "hr": "Ne slažem se s tobom.",
      "de": "Ich bin nicht deiner Meinung.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_04",
      "hr": "S jedne strane, posao je zanimljiv.",
      "de": "Einerseits ist die Arbeit interessant.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_05",
      "hr": "S druge strane, plaća je mala.",
      "de": "Andererseits ist das Gehalt niedrig.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_06",
      "hr": "Na kojoj si strani?",
      "de": "Auf welcher Seite stehst du?"
    },
    {
      "id": "s_18_07",
      "hr": "Iako je skupo, kupit ću to.",
      "de": "Obwohl es teuer ist, kaufe ich es.",
      "grammar": "g_b1_veznici"
    },
    {
      "id": "s_18_08",
      "hr": "Učim hrvatski zato što volim Hrvatsku.",
      "de": "Ich lerne Kroatisch, weil ich Kroatien liebe.",
      "grammar": "g_b1_veznici"
    },
    {
      "id": "s_18_09",
      "hr": "Umoran sam, zato idem kući.",
      "de": "Ich bin müde, deshalb gehe ich nach Hause.",
      "grammar": "g_b1_veznici"
    },
    {
      "id": "s_18_10",
      "hr": "To je vrlo važno.",
      "de": "Das ist sehr wichtig."
    },
    {
      "id": "s_18_11",
      "hr": "To nije problem.",
      "de": "Das ist kein Problem."
    },
    {
      "id": "s_18_12",
      "hr": "To nije istina!",
      "de": "Das ist nicht wahr!"
    },
    {
      "id": "s_18_13",
      "hr": "Imaš pravo.",
      "de": "Du hast recht.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_14",
      "hr": "Mislim da griješiš.",
      "de": "Ich glaube, du irrst dich.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_15",
      "hr": "Ne vjerujem ti.",
      "de": "Ich glaube dir nicht."
    },
    {
      "id": "s_18_16",
      "hr": "Sumnjam da je to istina.",
      "de": "Ich bezweifle, dass das wahr ist.",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_17",
      "hr": "Slažeš li se sa mnom?",
      "de": "Bist du meiner Meinung?",
      "grammar": "g_b1_misljenje"
    },
    {
      "id": "s_18_18",
      "hr": "Svakako ću doći.",
      "de": "Ich komme auf jeden Fall."
    },
    {
      "id": "s_18_19",
      "hr": "Volim voće, na primjer jabuke.",
      "de": "Ich mag Obst, zum Beispiel Äpfel."
    },
    {
      "id": "s_18_20",
      "hr": "To je loš primjer.",
      "de": "Das ist ein schlechtes Beispiel."
    },
    {
      "id": "s_18_21",
      "hr": "Ovaj restoran je bolji.",
      "de": "Dieses Restaurant ist besser.",
      "grammar": "g_b1_komparativ"
    },
    {
      "id": "s_18_22",
      "hr": "Ovo je najbolja kava u gradu.",
      "de": "Das ist der beste Kaffee der Stadt.",
      "grammar": "g_b1_komparativ"
    },
    {
      "id": "s_18_23",
      "hr": "Imamo isto mišljenje.",
      "de": "Wir sind derselben Meinung."
    },
    {
      "id": "s_18_24",
      "hr": "Ja imam drugačije mišljenje.",
      "de": "Ich bin anderer Meinung."
    },
    {
      "id": "s_18_25",
      "hr": "Općenito, ljudi su ovdje dobri.",
      "de": "Im Allgemeinen sind die Leute hier nett."
