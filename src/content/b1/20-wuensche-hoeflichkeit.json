  "sentences": [
    {
      "id": "s_20_01",
      "hr": "Imam jednu želju.",
      "de": "Ich habe einen Wunsch."
    },
    {
      "id": "s_20_02",
      "hr": "Radije pijem čaj.",
      "de": "Ich trinke lieber Tee."
    },
    {
      "id": "s_20_03",
      "hr": "Najradije bih spavao cijeli dan.",
      "de": "Am liebsten würde ich den ganzen Tag schlafen.",
      "grammar": "g_b1_kondicional"
    },
    {
      "id": "s_20_04",
      "hr": "Pomogao bih ti, ali nemam vremena.",
      "de": "Ich würde dir helfen, aber ich habe keine Zeit.",
      "grammar": "g_b1_kondicional"
    },
    {
      "id": "s_20_05",
      "hr": "Vi ste vrlo ljubazni.",
      "de": "Sie sind sehr freundlich."
    },
    {
      "id": "s_20_06",
      "hr": "Smeta li Vam ako otvorim prozor?",
      "de": "Stört es Sie, wenn ich das Fenster öffne?",
      "grammar": "g_b1_ljubaznost"
    },
    {
      "id": "s_20_07",
      "hr": "Dopustite mi da Vam pomognem.",
      "de": "Erlauben Sie mir, Ihnen zu helfen.",
      "grammar": "g_b1_ljubaznost"
    },
    {
      "id": "s_20_08",
      "hr": "Biste li mi mogli posuditi kišobran?",
      "de": "Könnten Sie mir einen Regenschirm leihen?",
      "grammar": "g_b1_ljubaznost"
    },
    {
      "id": "s_20_09",
      "hr": "Mogu li Vas nešto zamoliti?",
      "de": "Darf ich Sie um etwas bitten?",
      "grammar": "g_b1_ljubaznost"
    },
    {
      "id": "s_20_10",
      "hr": "Vrlo sam ti zahvalan.",
      "de": "Ich bin dir sehr dankbar."
    },
    {
      "id": "s_20_11",
      "hr": "Kad bih dobio na lutriji, putovao bih.",
      "de": "Wenn ich im Lotto gewinnen würde, würde ich reisen.",
      "grammar": "g_b1_kad_bih"
    },
    {
      "id": "s_20_12",
      "hr": "Što bi napravio s milijunom eura?",
      "de": "Was würdest du mit einer Million Euro machen?",
      "grammar": "g_b1_kondicional"
    },
    {
      "id": "s_20_13",
      "hr": "Kad bih bio bogat, kupio bih kuću.",
      "de": "Wenn ich reich wäre, würde ich ein Haus kaufen.",
      "grammar": "g_b1_kad_bih"
    },
    {
      "id": "s_20_14",
      "hr": "Volio bih vidjeti cijeli svijet.",
      "de": "Ich würde gern die ganze Welt sehen.",
      "grammar": "g_b1_kondicional"
    },
    {
      "id": "s_20_15",
      "hr": "Htio bih obići cijelu Hrvatsku.",
      "de": "Ich würde gern ganz Kroatien bereisen.",
      "grammar": "g_b1_kondicional"
    },
    {
      "id": "s_20_16",
      "hr": "Uzmi kišobran, inače ćeš biti mokar.",
      "de": "Nimm einen Schirm, sonst wirst du nass."
    },
    {
      "id": "s_20_17",
      "hr": "Trebam tvoj savjet.",
      "de": "Ich brauche deinen Rat."
    },
    {
      "id": "s_20_18",
      "hr": "Na tvom mjestu ne bih to kupio.",
      "de": "An deiner Stelle würde ich das nicht kaufen.",
      "grammar": "g_b1_kondicional",
      "note": "Verneint: ne bih"
    },
    {
      "id": "s_20_19",
      "hr": "Zamisli, dobio sam posao!",
      "de": "Stell dir vor, ich habe die Stelle bekommen!"
    },
    {
      "id": "s_20_20",
      "hr": "Sanjam o kući na moru.",
      "de": "Ich träume von einem Haus am Meer."
    },
    {
      "id": "s_20_21",
      "hr": "Imam svoj stan.",
      "de": "Ich habe eine eigene Wohnung.",
      "grammar": "g_b1_svoj"
    },
    {
      "id": "s_20_22",
      "hr": "Želim ostvariti svoj san.",
      "de": "Ich will meinen Traum verwirklichen.",
      "grammar": "g_b1_svoj"
    },
    {
      "id": "s_20_23",
      "hr": "Šteta što ne možeš doći.",
      "de": "Schade, dass du nicht kommen kannst."
    }
  ]
