  "sentences": [
    {
      "id": "s_25_01",
      "hr": "Sretni blagdani!",
      "de": "Frohe Feiertage!",
      "grammar": "g_b1_blagdani"
    },
    {
      "id": "s_25_02",
      "hr": "Za Božić idemo kući.",
      "de": "An Weihnachten fahren wir nach Hause.",
      "grammar": "g_b1_blagdani"
    },
    {
      "id": "s_25_03",
      "hr": "Sretan Božić!",
      "de": "Frohe Weihnachten!",
      "grammar": "g_b1_blagdani"
    },
    {
      "id": "s_25_04",
      "hr": "Uskrs slavimo s obitelji.",
      "de": "Ostern feiern wir mit der Familie."
    },
    {
      "id": "s_25_05",
      "hr": "Gdje slaviš Novu godinu?",
      "de": "Wo feierst du Silvester?",
      "grammar": "g_b1_blagdani"
    },
    {
      "id": "s_25_06",
      "hr": "Advent u Zagrebu je vrlo lijep.",
      "de": "Der Advent in Zagreb ist sehr schön."
    },
    {
      "id": "s_25_07",
      "hr": "Kako ste proslavili Božić?",
      "de": "Wie habt ihr Weihnachten gefeiert?",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_25_08",
      "hr": "To je stara tradicija.",
      "de": "Das ist eine alte Tradition."
    },
    {
      "id": "s_25_09",
      "hr": "Kakvi su običaji?",
      "de": "Was gibt es für Bräuche?"
    },
    {
      "id": "s_25_10",
      "hr": "Na fašniku nosimo maske.",
      "de": "Am Fasching tragen wir Masken."
    },
    {
      "id": "s_25_11",
      "hr": "Klapa pjeva u konobi.",
      "de": "Die Klapa singt in der Konoba."
    },
    {
      "id": "s_25_12",
      "hr": "Ovo je stara pjesma.",
      "de": "Das ist ein altes Lied."
    },
    {
      "id": "s_25_13",
      "hr": "Ovo je narodna nošnja.",
      "de": "Das ist eine Volkstracht."
    },
    {
      "id": "s_25_14",
      "hr": "Volim hrvatsku kulturu.",
      "de": "Ich liebe die kroatische Kultur."
    },
    {
      "id": "s_25_15",
      "hr": "Hrvatska ima bogatu povijest.",
      "de": "Kroatien hat eine reiche Geschichte."
    },
    {
      "id": "s_25_16",
      "hr": "Krleža je hrvatski pisac.",
      "de": "Krleža ist ein kroatischer Schriftsteller."
    },
    {
      "id": "s_25_17",
      "hr": "Čitam dobru knjigu.",
      "de": "Ich lese ein gutes Buch."
    },
    {
      "id": "s_25_18",
      "hr": "Na Božić idemo na misu.",
      "de": "An Weihnachten gehen wir in die Messe.",
      "grammar": "g_b1_blagdani"
    },
    {
      "id": "s_25_19",
      "hr": "Ukrasili smo bor.",
      "de": "Wir haben den Baum geschmückt.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_25_20",
      "hr": "Za Uskrs radimo pisanice.",
      "de": "Zu Ostern bemalen wir Eier."
    },
    {
      "id": "s_25_21",
      "hr": "To je obiteljski ručak.",
      "de": "Das ist ein Familienessen."
    },
    {
      "id": "s_25_22",
      "hr": "Cijela obitelj se okupi za Božić.",
      "de": "Die ganze Familie kommt an Weihnachten zusammen."
    },
    {
      "id": "s_25_23",
      "hr": "Djeca dobiju darove.",
      "de": "Die Kinder bekommen Geschenke."
    },
    {
      "id": "s_25_24",
      "hr": "U ponoć je vatromet.",
      "de": "Um Mitternacht gibt es ein Feuerwerk."
    }
  ],
