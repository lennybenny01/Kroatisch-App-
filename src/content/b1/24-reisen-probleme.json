  "canDo": [
    "Ich kann Verspätungen und Ausfälle verstehen.",
    "Ich kann ein verlorenes oder gestohlenes Gepäckstück melden.",
    "Ich kann eine Panne beschreiben und Hilfe holen.",
    "Ich kann mich im Hotel höflich beschweren."
  ],
