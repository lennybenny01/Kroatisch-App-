  "sentences": [
    {
      "id": "s_19_01",
      "hr": "Najprije sam popio kavu.",
      "de": "Zuerst habe ich einen Kaffee getrunken.",
      "grammar": "g_b1_pricanje"
    },
    {
      "id": "s_19_02",
      "hr": "Zatim sam išao na posao.",
      "de": "Dann bin ich zur Arbeit gegangen.",
      "grammar": "g_b1_pricanje"
    },
    {
      "id": "s_19_03",
      "hr": "Nakon toga smo jeli ribu.",
      "de": "Danach haben wir Fisch gegessen.",
      "grammar": "g_b1_pricanje"
    },
    {
      "id": "s_19_04",
      "hr": "Do kraja ulice, pa lijevo.",
      "de": "Bis zum Ende der Straße, dann links."
    },
    {
      "id": "s_19_05",
      "hr": "Na kraju smo bili sretni.",
      "de": "Am Ende waren wir glücklich.",
      "grammar": "g_b1_pricanje"
    },
    {
      "id": "s_19_06",
      "hr": "Dok sam spavao, padala je kiša.",
      "de": "Während ich schlief, regnete es.",
      "grammar": "g_b1_aspekt_pricanje"
    },
    {
      "id": "s_19_07",
      "hr": "Čim dođeš, javi se.",
      "de": "Sobald du da bist, melde dich.",
      "grammar": "g_b1_aspekt_pricanje"
    },
    {
      "id": "s_19_08",
      "hr": "Operi ruke prije nego što jedeš.",
      "de": "Wasch dir die Hände, bevor du isst.",
      "grammar": "g_b1_pricanje"
    },
    {
      "id": "s_19_09",
      "hr": "Ne mogu se sjetiti.",
      "de": "Es fällt mir nicht ein.",
      "grammar": "g_b1_sjecati"
    },
    {
      "id": "s_19_10",
      "hr": "To je zanimljiva priča.",
      "de": "Das ist eine interessante Geschichte."
    },
    {
      "id": "s_19_11",
      "hr": "Mislim o tebi.",
      "de": "Ich denke an dich.",
      "note": "misliti o + Lokativ"
    },
    {
      "id": "s_19_12",
      "hr": "Pričaj mi o tome!",
      "de": "Erzähl mir davon!"
    },
    {
      "id": "s_19_13",
      "hr": "Ispričat ću ti sve.",
      "de": "Ich erzähle dir alles."
    },
    {
      "id": "s_19_14",
      "hr": "Jedanput sam bio u Dubrovniku.",
      "de": "Ich war einmal in Dubrovnik.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_19_15",
      "hr": "Nekad sam živio na selu.",
      "de": "Früher habe ich auf dem Land gewohnt.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_19_16",
      "hr": "U djetinjstvu sam često bio na moru.",
      "de": "In meiner Kindheit war ich oft am Meer."
    },
    {
      "id": "s_19_17",
      "hr": "Odrastao sam u Njemačkoj.",
      "de": "Ich bin in Deutschland aufgewachsen.",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_19_18",
      "hr": "Iznenada je počela kiša.",
      "de": "Plötzlich fing es an zu regnen.",
      "grammar": "g_b1_pricanje"
    },
    {
      "id": "s_19_19",
      "hr": "Krenuli smo rano ujutro.",
      "de": "Wir sind früh am Morgen aufgebrochen.",
      "grammar": "g_b1_aspekt_pricanje"
    },
    {
      "id": "s_19_20",
      "hr": "Stigli smo kasno navečer.",
      "de": "Wir sind spät abends angekommen.",
      "grammar": "g_b1_aspekt_pricanje"
    },
    {
      "id": "s_19_21",
      "hr": "Vidio sam nesreću.",
      "de": "Ich habe einen Unfall gesehen."
    },
    {
      "id": "s_19_22",
      "hr": "Imao sam sreće.",
      "de": "Ich hatte Glück.",
      "grammar": "g_genitiv"
    },
    {
      "id": "s_19_23",
      "hr": "Što si doživio?",
      "de": "Was hast du erlebt?",
      "grammar": "g_perfekt"
    },
    {
      "id": "s_19_24",
      "hr": "To je bilo vrlo smiješno.",
      "de": "Das war sehr lustig."
    },
    {
      "id": "s_19_25",
      "hr": "Bojim se pasa.",
      "de": "Ich habe Angst vor Hunden.",
      "grammar": "g_b1_sjecati",
      "note": "bojati se + Genitiv (Plural: pasa)"
    },
    {
      "id": "s_19_26",
      "hr": "Bilo me strah.",
      "de": "Ich hatte Angst."
    },
    {
      "id": "s_19_27",
      "hr": "Upravo sam stigao.",
      "de": "Ich bin gerade angekommen."
    },
    {
      "id": "s_19_28",
      "hr": "Tada sam imao dvadeset godina.",
      "de": "Damals war ich zwanzig."
    }
  ],
