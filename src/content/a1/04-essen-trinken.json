      "de": "Kaffee mit Milch, bitte.",
      "grammar": "g_instrumental_s",
      "note": "mlijeko → s mlijekom"
    },
    {
      "id": "s_04_06",
      "hr": "Volim kavu.",
      "de": "Ich mag Kaffee.",
      "grammar": "g_akkusativ"
    },
    {
      "id": "s_04_07",
      "hr": "Ne pijem vino.",
      "de": "Ich trinke keinen Wein.",
      "grammar": "g_praesens"
    },
    {
      "id": "s_04_08",
      "hr": "Hladno pivo, molim.",
      "de": "Ein kaltes Bier, bitte."
    },
    {
      "id": "s_04_09",
      "hr": "Imate li kruha?",
      "de": "Haben Sie Brot?",
      "grammar": "g_genitiv_menge",
      "note": "Teilmenge: Genitiv (etwas Brot)"
    },
    {
      "id": "s_04_10",
      "hr": "Volim ribu.",
      "de": "Ich mag Fisch.",
      "grammar": "g_akkusativ",
      "note": "riba → ribu"
    },
    {
      "id": "s_04_11",
      "hr": "Jedem piletinu i salatu.",
      "de": "Ich esse Hähnchen und Salat.",
      "grammar": "g_akkusativ"
    },
    {
      "id": "s_04_12",
      "hr": "Ribu s krumpirom, molim.",
      "de": "Fisch mit Kartoffeln, bitte.",
      "grammar": "g_instrumental_s"
    },
    {
      "id": "s_04_13",
      "hr": "Kavu sa šećerom, molim.",
      "de": "Kaffee mit Zucker, bitte.",
      "grammar": "g_instrumental_s",
      "note": "vor š: sa statt s"
    },
    {
      "id": "s_04_14",
      "hr": "Čaj bez šećera.",
      "de": "Tee ohne Zucker.",
      "grammar": "g_genitiv_menge",
      "note": "bez + Genitiv: šećer → šećera"
    },
    {
      "id": "s_04_15",
      "hr": "Malo kruha, molim.",
      "de": "Ein bisschen Brot, bitte.",
      "grammar": "g_genitiv_menge"
    },
    {
      "id": "s_04_16",
      "hr": "Hvala puno!",
      "de": "Vielen Dank!"
    },
    {
      "id": "s_04_17",
      "hr": "Još jednu kavu, molim.",
      "de": "Noch einen Kaffee, bitte.",
      "grammar": "g_akkusativ",
      "note": "jedna kava → jednu kavu"
    },
    {
      "id": "s_04_18",
      "hr": "Gladan sam.",
      "de": "Ich habe Hunger.",
      "note": "Wörtlich: Ich bin hungrig. Frau: Gladna sam."
    },
    {
      "id": "s_04_19",
      "hr": "Žedna sam.",
      "de": "Ich habe Durst.",
      "note": "Frau: žedna · Mann: žedan"
    },
    {
      "id": "s_04_20",
      "hr": "Riba je ukusna.",
      "de": "Der Fisch ist lecker."
    },
    {
      "id": "s_04_21",
      "hr": "Doručak je u osam sati.",
      "de": "Frühstück ist um acht Uhr."
    },
    {
      "id": "s_04_22",
      "hr": "Ovo je dobar restoran.",
      "de": "Das ist ein gutes Restaurant."
    },
    {
      "id": "s_04_23",
      "hr": "Imate li jelovnik?",
      "de": "Haben Sie eine Speisekarte?"
    },
    {
      "id": "s_04_24",
      "hr": "Račun, molim!",
      "de": "Die Rechnung, bitte!"
    },
    {
      "id": "s_04_25",
      "hr": "Čašu vode, molim.",
      "de": "Ein Glas Wasser, bitte.",
      "grammar": "g_genitiv_menge",
      "note": "čaša + Genitiv: vode"
    }
  ]
}
