{
  "id": "a1_04",
  "order": 4,
  "level": "A1",
  "title": "Essen & Trinken",
  "description": "Im Café und Restaurant bestellen, über Essen sprechen – und dabei den Akkusativ kennenlernen.",
  "canDo": [
    "Ich kann im Café und Restaurant bestellen und bezahlen.",
    "Ich kann sagen, was ich gern esse und trinke.",
    "Ich kann sagen, dass ich Hunger oder Durst habe.",
    "Ich kann Mengen angeben: ein Glas Wasser, ohne Zucker."
  ],
  "grammar": [
    {
      "id": "g_praesens",
      "title": "Präsens: drei Muster",
      "summary": "Die ich-Form endet auf -am, -im oder -em.",
      "body": [
        "Am Infinitiv sieht man das Muster nicht immer – lerne die ich-Form mit: piti → pijem, jesti → jedem.",
        "Verneinung: ne steht vor dem Verb: Ne pijem kavu."
      ],
      "table": {
        "head": [
          "Person",
          "-am (čitati)",
          "-im (voljeti)",
          "-em (piti)"
        ],
        "rows": [
