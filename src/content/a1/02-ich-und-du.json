  "order": 2,
  "level": "A1",
  "title": "Ich und du",
  "description": "Pronomen, „sein“ und „haben“: sagen, wer man ist, woher man kommt und was man hat.",
  "canDo": [
    "Ich kann sagen, wer ich bin und woher ich komme.",
    "Ich kann einfache Ja/Nein-Fragen stellen.",
    "Ich kann sagen, was ich habe und was nicht.",
    "Ich kann Personen und Dinge mit einfachen Adjektiven beschreiben."
  ],
  "grammar": [
