{
  "id": "a1_07",
  "order": 7,
  "level": "A1",
  "title": "Orte & Richtungen",
  "description": "Sich in der Stadt orientieren, nach dem Weg fragen – und den Unterschied zwischen „wo?“ und „wohin?“ verstehen.",
  "canDo": [
    "Ich kann sagen, wo ich bin und wohin ich gehe.",
    "Ich kann nach dem Weg fragen und einfache Wegbeschreibungen verstehen.",
    "Ich kann wichtige Orte in der Stadt nennen.",
    "Ich kann sagen, wie ich unterwegs bin (Bus, Zug, zu Fuß)."
  ],
  "grammar": [
    {
      "id": "g_lokativ",
      "title": "Wo? – u / na + Lokativ",
      "summary": "u gradu, u školi, na moru",
      "body": [
        "Auf die Frage „Wo?“ steht nach u und na der Lokativ – im Deutschen wäre das der Dativ: in der Stadt.",
        "Maskulin und Neutrum: -u. Feminin: -i. Länder auf -ska / -čka: -oj.",
        "Bei Wörtern auf -ka wird k zu c: banka → u banci."
      ],
      "table": {
        "head": [
          "Genus",
          "Nominativ",
          "Lokativ"
        ],
        "rows": [
          [
            "maskulin",
            "grad, ured",
            "u gradu, u uredu"
          ],
          [
            "neutrum",
            "more, selo",
            "na moru, na selu"
          ],
          [
            "feminin",
            "škola, bolnica",
            "u školi, u bolnici"
          ],
          [
            "Länder",
            "Hrvatska, Njemačka",
            "u Hrvatskoj, u Njemačkoj"
          ]
        ]
      }
    },
    {
      "id": "g_wohin",
      "title": "Wohin? – u / na + Akkusativ",
      "summary": "Idem u grad. Idem na plažu.",
      "body": [
        "Gleiche Präposition, anderer Fall – genau wie im Deutschen: in der Stadt (wo?) / in die Stadt (wohin?).",
        "Das Fragewort für „wohin“ ist kamo."
      ],
      "table": {
        "head": [
          "Wo? (Lokativ)",
          "Wohin? (Akkusativ)"
        ],
        "rows": [
          [
            "u gradu",
            "u grad"
          ],
          [
            "u školi",
            "u školu"
          ],
          [
            "na plaži",
            "na plažu"
          ],
          [
            "na pošti",
            "na poštu"
          ],
          [
            "u Hrvatskoj",
            "u Hrvatsku"
          ]
        ]
      }
    },
    {
      "id": "g_u_na",
      "title": "u oder na?",
      "summary": "Das muss man mitlernen.",
      "body": [
        "u steht bei geschlossenen Räumen, Gebäuden, Städten und Ländern: u kući, u školi, u Zagrebu, u Njemačkoj.",
        "na steht bei Flächen, Inseln und einigen festen Orten: na trgu, na otoku, na moru, na plaži, na selu, na pošti, na poslu.",
        "Tipp: Lerne jeden Ort gleich mit seiner Präposition."
      ]
    },
    {
      "id": "g_genitiv_orte",
      "title": "Woher, bei, bis – mit Genitiv",
      "summary": "iz, s, kod, do, od + Genitiv",
      "body": [
        "Woher? iz (aus) bei u-Orten, s (von) bei na-Orten: iz grada, s mora, s plaže.",
        "kod = bei: kod kuće (zu Hause).",
        "do = bis / zu: Kako mogu doći do kolodvora? – Wie komme ich zum Bahnhof?",
        "od = von / ab: od ponedjeljka (ab Montag)."
      ]
    }
  ],
