      "note": "do + Genitiv"
    },
    {
      "id": "s_07_21",
      "hr": "Prva ulica lijevo.",
      "de": "Die erste Straße links."
    },
    {
      "id": "s_07_22",
      "hr": "Idem autobusom.",
