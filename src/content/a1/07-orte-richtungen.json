      "note": "grad → u gradu"
    },
    {
      "id": "s_07_02",
      "hr": "Moji roditelji žive na selu.",
      "de": "Meine Eltern leben auf dem Land.",
      "grammar": "g_u_na"
    },
    {
      "id": "s_07_03",
      "hr": "Imaju veliku kuću.",
      "de": "Sie haben ein großes Haus.",
      "grammar": "g_akkusativ"
    },
    {
      "id": "s_07_04",
      "hr": "Gdje je hotel?",
      "de": "Wo ist das Hotel?"
    },
    {
      "id": "s_07_05",
      "hr": "Idem u trgovinu.",
      "de": "Ich gehe in den Laden.",
      "grammar": "g_wohin",
      "note": "wohin: u + Akkusativ"
    },
    {
      "id": "s_07_06",
      "hr": "Gdje je banka?",
      "de": "Wo ist die Bank?"
    },
    {
      "id": "s_07_07",
      "hr": "Moram ići na poštu.",
      "de": "Ich muss zur Post.",
      "grammar": "g_u_na",
      "note": "pošta → na poštu"
    },
    {
      "id": "s_07_08",
      "hr": "Moj otac je u bolnici.",
      "de": "Mein Vater ist im Krankenhaus.",
      "grammar": "g_lokativ",
      "note": "bolnica → u bolnici"
    },
    {
      "id": "s_07_09",
      "hr": "Djeca su u školi.",
      "de": "Die Kinder sind in der Schule.",
      "grammar": "g_lokativ",
      "note": "škola → u školi"
    },
    {
      "id": "s_07_10",
      "hr": "Gdje je kolodvor?",
      "de": "Wo ist der Bahnhof?"
    },
    {
      "id": "s_07_11",
      "hr": "Idem u zračnu luku.",
      "de": "Ich fahre zum Flughafen.",
      "grammar": "g_wohin"
    },
    {
      "id": "s_07_12",
      "hr": "Idemo na plažu!",
      "de": "Wir gehen an den Strand!",
      "grammar": "g_wohin",
      "note": "plaža → na plažu"
    },
    {
      "id": "s_07_13",
      "hr": "Živimo na otoku.",
      "de": "Wir leben auf einer Insel.",
      "grammar": "g_u_na",
      "note": "otok → na otoku"
    },
    {
      "id": "s_07_14",
      "hr": "Oprostite, gdje je zahod?",
      "de": "Entschuldigung, wo ist die Toilette?"
    },
    {
      "id": "s_07_15",
      "hr": "Hotel je lijevo.",
      "de": "Das Hotel ist links."
    },
    {
      "id": "s_07_16",
      "hr": "Idite ravno.",
      "de": "Gehen Sie geradeaus.",
      "note": "idite = Befehlsform (Sie) von ići"
    },
    {
      "id": "s_07_17",
      "hr": "Je li pošta blizu?",
      "de": "Ist die Post in der Nähe?",
      "grammar": "g_fragen"
    },
    {
      "id": "s_07_18",
      "hr": "Kamo ideš?",
      "de": "Wohin gehst du?",
      "grammar": "g_wohin"
    },
    {
      "id": "s_07_19",
      "hr": "Danas sam kod kuće.",
      "de": "Heute bin ich zu Hause.",
      "grammar": "g_genitiv_orte",
      "note": "kod + Genitiv: kuća → kod kuće"
    },
    {
      "id": "s_07_20",
      "hr": "Kako mogu doći do kolodvora?",
      "de": "Wie komme ich zum Bahnhof?",
